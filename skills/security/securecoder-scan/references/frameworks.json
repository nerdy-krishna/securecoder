{
  "_about": "Registry of compliance frameworks supported by /securecoder-scan Phase B and /securecoder-build. Each entry declares its source (a git repo, or \"bundled\" for frameworks shipped in this repo), the chapter directory structure, the relevance file, and the control-ID regexes used by validate_coverage.py. The `layer` field is `baseline` (always runs) or `overlay` (domain-specialized, subject to fit-detection). See docs/design.md §3.10.",
  "_schema_version": "1.1",
  "_frameworks": {
    "secure-coding-essentials": {
      "name": "Secure Coding Essentials",
      "purpose": "universal-baseline",
      "layer": "baseline",
      "source": "bundled",
      "bundled_path": "references/frameworks/secure-coding-essentials",
      "chapter_dir": ".",
      "chapter_filename_pattern": "SCE-*.md",
      "control_id_regex": "\\*\\*(SCE-[A-Z]+-\\d+)\\*\\*",
      "control_id_response_regex": "\\b(SCE-[A-Z]+-\\d+)\\b",
      "control_id_prefix": "SCE-",
      "relevance_file": "relevance-secure-coding-essentials.json",
      "scannable": true,
      "default_enabled": true,
      "target_languages": ["all"]
    },
    "asvs-v5": {
      "name": "OWASP ASVS v5",
      "purpose": "web-app-compliance",
      "layer": "overlay",
      "source": "https://github.com/OWASP/ASVS.git",
      "branch": "master",
      "chapter_dir": "5.0/en",
      "chapter_filename_pattern": "0x*-V*-*.md",
      "control_id_regex": "\\*\\*(\\d+\\.\\d+\\.\\d+)\\*\\*",
      "control_id_response_regex": "\\bV?(\\d+\\.\\d+\\.\\d+)\\b",
      "control_id_prefix": "V",
      "relevance_file": "relevance-asvs-v5.json",
      "scannable": true,
      "default_enabled": true,
      "target_languages": ["python", "javascript", "typescript", "go", "java", "kotlin", "ruby", "php", "csharp"],
      "signal_globs": ["requirements.txt", "package.json", "pom.xml", "build.gradle", "Gemfile", "composer.json", "go.mod", "*.csproj"]
    },
    "masvs": {
      "name": "OWASP MASVS",
      "purpose": "mobile-app-compliance",
      "layer": "overlay",
      "source": "https://github.com/OWASP/owasp-masvs.git",
      "branch": "master",
      "chapter_dir": "Document/en",
      "chapter_filename_pattern": "0x*-MASVS-*.md",
      "control_id_regex": "\\*\\*(MASVS-[A-Z]+-\\d+)\\*\\*",
      "control_id_response_regex": "\\b(MASVS-[A-Z]+-\\d+)\\b",
      "control_id_prefix": "MASVS-",
      "relevance_file": "relevance-masvs.json",
      "scannable": true,
      "default_enabled": false,
      "auto_enable_on": ["ios", "android", "kotlin", "swift", "react-native"],
      "target_languages": ["swift", "kotlin", "java", "objective-c", "dart"],
      "signal_globs": ["AndroidManifest.xml", "Info.plist", "Podfile", "build.gradle", "pubspec.yaml"]
    },
    "proactive-controls": {
      "name": "OWASP Proactive Controls",
      "purpose": "defensive-design-checklist",
      "layer": "overlay",
      "source": "https://github.com/OWASP/www-project-proactive-controls.git",
      "branch": "master",
      "chapter_dir": "v4/en",
      "chapter_filename_pattern": "0x*-C*-*.md",
      "control_id_regex": "\\*\\*(C\\d+)\\*\\*",
      "control_id_response_regex": "\\b(C\\d+)\\b",
      "control_id_prefix": "C",
      "relevance_file": "relevance-proactive-controls.json",
      "scannable": true,
      "default_enabled": false,
      "target_languages": ["python", "javascript", "typescript", "go", "java", "kotlin", "ruby", "php", "csharp"],
      "signal_globs": ["requirements.txt", "package.json", "pom.xml", "build.gradle", "Gemfile", "composer.json", "go.mod", "*.csproj"]
    },
    "cheatsheets": {
      "name": "OWASP Cheat Sheet Series",
      "purpose": "remediation-reference",
      "layer": "overlay",
      "source": "https://github.com/OWASP/CheatSheetSeries.git",
      "branch": "master",
      "chapter_dir": "cheatsheets",
      "chapter_filename_pattern": "*.md",
      "control_id_regex": null,
      "control_id_response_regex": null,
      "control_id_prefix": null,
      "relevance_file": null,
      "scannable": false,
      "default_enabled": false,
      "_note": "Cheatsheets are NOT scanned against. They're fetched to enrich /securecoder-fix's remediation prompts and to ground /securecoder-advise answers."
    }
  },
  "_mobile_stack_signals": {
    "ios": ["*.swift", "Podfile", "Podfile.lock", "Info.plist"],
    "android": ["AndroidManifest.xml", "build.gradle", "*.kt", "*.java"],
    "react-native": ["react-native.config.js", "metro.config.js"],
    "flutter": ["pubspec.yaml", "pubspec.lock"]
  }
}
