{
  "_about": "Per-chapter applicability for the secure-coding-essentials baseline framework. Seven of nine chapters apply to all languages. SCE-MEM and SCE-INT are split: applies_to_languages lists the languages where the chapter applies unconditionally; conditional_languages lists additional languages where the chapter applies only when a keyword_trigger is found in the file (the FFI / unsafe escape hatch). See docs/design.md §3.10.",
  "_schema_version": "1.0",
  "_chapters": {
    "SCE-MEM": {
      "id": "SCE-MEM",
      "title": "Memory Safety",
      "filename": "SCE-MEM.md",
      "applies_to_languages": ["c", "cpp", "rust", "zig", "objective-c", "assembly"],
      "conditional_languages": {
        "languages": ["python", "javascript", "typescript", "ruby", "java", "kotlin", "go", "csharp", "php", "swift"],
        "keyword_triggers": ["ctypes", "cffi", "unsafe", "jni", "cgo", "marshal", "unsafe.Pointer", "Buffer", "memoryview", "NativeModules", "extern"]
      },
      "keyword_triggers": []
    },
    "SCE-INT": {
