      "conditional_languages": {
        "languages": ["python", "javascript", "typescript", "ruby", "php"],
        "keyword_triggers": ["struct.pack", "struct.unpack", "to_bytes", "from_bytes", "& 0xff", "<<", ">>", "ctypes", "Buffer.alloc", "DataView", "Int32Array"]
      },
      "keyword_triggers": []
    },
